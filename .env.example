# Compose reads the repo-root .env. Create or complete it with `make init`, which fills
# VLLM_API_KEY and MODELS_DIR and appends any keys added here later.

LOG_LEVEL=INFO

# Postgres (only reachable inside the compose network)
POSTGRES_USER=angebot
POSTGRES_PASSWORD=angebot
POSTGRES_DB=angebot

# Shared API key of the local vLLM servers (generated by make init)
VLLM_API_KEY=

# Absolute path of the model weights directory (make init: $HOME/models)
MODELS_DIR=

# Interface the API and UI ports bind to; 0.0.0.0 makes them reachable from other machines
BIND_ADDR=127.0.0.1

# Model directories under MODELS_DIR served on GPU 0 (llm) and GPU 1 (vlm)
LLM_MODEL_DIR=qwen3.5-9b
VLM_MODEL_DIR=qwen3.5-9b

# Sent in every request's User-Agent so retailers and OSM can identify and reach the operator
CONTACT=https://github.com/Parikshit00/grocery-deals-agent

# Scan limits: seconds for one chain's network/browser phases, concurrent Chromium instances
CHAIN_BUDGET_S=300
MAX_BROWSERS=3
# Concurrent page requests to the VLM (match the vlm server's --max-num-seqs)
VLM_MAX_INFLIGHT=32
# Context length of the vlm server; extraction sizes its output budget from it
VLM_MAX_MODEL_LEN=8192
# Chromium sandbox for the browser tier (keep true; see ADR 0003 if it must be off)
CHROMIUM_SANDBOX=true
# Demo only: "<chain>:<step>" (e.g. lidl:select_store) makes the navigator heal that step
FORCE_HEAL=
# Optional bearer token for the MCP endpoint /mcp (e.g. openssl rand -hex 32); empty = no token
MCP_TOKEN=

# Geocoder (OpenStreetMap Nominatim); point at another instance without a code change
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Share of its GPU each vLLM server may claim (room for other workloads; raise for larger models)
LLM_GPU_MEMORY_UTILIZATION=0.80
VLM_GPU_MEMORY_UTILIZATION=0.80

# Observability (make obs-up). Secrets and Langfuse project keys are generated by make init.
# TRACING_ENABLED=true sends the backend's OpenTelemetry traces to Langfuse.
TRACING_ENABLED=true
# URL the browser uses for Langfuse (login redirects), e.g. http://<this host>:28736
LANGFUSE_URL=http://localhost:28736
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ADMIN_EMAIL=admin@gda.local
LANGFUSE_ADMIN_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_DB_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
# Grafana admin (anonymous visitors get read-only dashboards)
GRAFANA_ADMIN_PASSWORD=
