{
 "uid": "gda-vllm",
 "title": "grocery-deals-agent: vLLM and GPUs",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "gda"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Running requests",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name) (vllm:num_requests_running)",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Waiting requests",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name) (vllm:num_requests_waiting)",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Prompt tokens/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name) (rate(vllm:prompt_tokens_total[1m]))",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Generation tokens/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name) (rate(vllm:generation_tokens_total[1m]))",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "KV-cache usage",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (model_name) (vllm:kv_cache_usage_perc)",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Time to first token p50 / p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
     "legendFormat": "{{model_name}} p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
     "legendFormat": "{{model_name}} p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Inter-token latency p50 / p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, model_name) (rate(vllm:inter_token_latency_seconds_bucket[1m])))",
     "legendFormat": "{{model_name}} p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(vllm:inter_token_latency_seconds_bucket[1m])))",
     "legendFormat": "{{model_name}} p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "GPU utilization",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_GPU_UTIL",
     "legendFormat": "GPU {{gpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "GPU memory used",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_FB_USED * 1048576",
     "legendFormat": "GPU {{gpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "GPU power",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_POWER_USAGE",
     "legendFormat": "GPU {{gpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Energy per 1k generated tokens",
   "description": "GPU energy over the last 5 minutes divided by the tokens its server generated (llm on GPU 0, vlm on GPU 1). Whole-GPU energy from DCGM: on a shared GPU it includes other tenants' work, so it is an upper bound.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watth"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION{gpu=\"0\"}[5m])) / 3.6e6 / (sum(increase(vllm:generation_tokens_total{model_name=\"llm\"}[5m])) / 1000 > 0)",
     "legendFormat": "llm (GPU 0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION{gpu=\"1\"}[5m])) / 3.6e6 / (sum(increase(vllm:generation_tokens_total{model_name=\"vlm\"}[5m])) / 1000 > 0)",
     "legendFormat": "vlm (GPU 1)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 12,
   "type": "stat",
   "title": "GPU energy in the selected time range",
   "description": "Whole-GPU energy from DCGM: on a shared GPU it includes other tenants' work, so it is an upper bound.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watth",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[$__range]) / 3.6e6",
     "legendFormat": "GPU {{gpu}}",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  }
 ]
}
